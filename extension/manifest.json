{
  "manifest_version": 3,
  "name": "Case Study Studio Recorder",
  "version": "1.0.0",
  "description": "Record a flow through any website, screen by screen, and send it to Case Study Studio as a flowchart.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Record a flow" },
  "icons": { "128": "icon.png" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
