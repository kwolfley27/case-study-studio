{
  "manifest_version": 3,
  "name": "Miso for Case Study Studio",
  "version": "1.6.0",
  "description": "Click a frame in Figma and Miso copies it as PNG; tell Miso what to build with it and it does it in Case Study Studio. Chrome briefly shows \u201cstarted debugging this browser\u201d while Miso presses Copy as PNG for you.",
  "permissions": [
    "storage",
    "debugger",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Miso"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "cat.png",
        "cat-sleep.png"
      ],
      "matches": [
        "https://www.figma.com/*",
        "https://figma.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.figma.com/*",
        "https://figma.com/*"
      ],
      "js": [
        "figma.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kwolfley27.github.io/case-study-studio/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "studio.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-listening": {
      "suggested_key": {
        "default": "Ctrl+M",
        "mac": "MacCtrl+M"
      },
      "description": "Turn Miso's listening on or off"
    }
  }
}