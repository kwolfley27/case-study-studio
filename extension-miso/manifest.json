{
  "manifest_version": 3,
  "name": "Miso for Case Study Studio",
  "version": "1.8.0",
  "description": "Miso comes with you to Figma and any website. Hold Option and circle something to bring it (with its words) to Case Study Studio, then tell Miso what to make. On most sites Miso only appears while listening (\u2303M).",
  "permissions": [
    "storage",
    "debugger",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Miso"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "cat.png",
        "cat-sleep.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "figma.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://kwolfley27.github.io/case-study-studio/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ]
    },
    {
      "matches": [
        "https://kwolfley27.github.io/case-study-studio/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "studio.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-listening": {
      "suggested_key": {
        "default": "Ctrl+M",
        "mac": "MacCtrl+M"
      },
      "description": "Turn Miso's listening on or off"
    },
    "snip": {
      "suggested_key": {
        "default": "Ctrl+Shift+4",
        "mac": "MacCtrl+Shift+4"
      },
      "description": "Snip part of the page for Miso (drag a box)"
    }
  }
}